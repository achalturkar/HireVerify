generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// COMPANY
// ============================================================

model Company {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @db.VarChar(255)
  slug      String  @unique @db.VarChar(255)
  shortCode String? @unique @map("short_code") @db.VarChar(10)

  contactEmail String? @map("contact_email") @db.VarChar(255)
  contactPhone String? @map("contact_phone") @db.VarChar(50)

  logoUrl      String? @map("logo_url") @db.VarChar(500)
  signatureUrl String? @map("signature_url") @db.VarChar(500)
  stampUrl     String? @map("stamp_url") @db.VarChar(500)

  primaryColor String? @map("primary_color") @db.VarChar(20)
  address      String?

  settings Json @default("{}")

  status CompanyStatus @default(ACTIVE)

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users      User[]
  roles      Role[]
  clients    Client[]
  candidates Candidate[]
  bgvCases   BGVCase[]
  reports    BGVReport[]
  auditLogs  AuditLog[]

  @@index([status])
  @@index([isDeleted])
  @@index([name])
  @@map("companies")
}

// ============================================================
// ROLE
// ============================================================

model Role {
  id String @id @default(uuid()) @db.Uuid

  companyId String? @map("company_id") @db.Uuid

  name        String  @db.VarChar(100)
  description String?

  isSystem       Boolean @default(false) @map("is_system")
  isCompanyAdmin Boolean @default(false) @map("is_company_admin")
  isSuperAdmin   Boolean @default(false) @map("is_super_admin")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users User[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

// ============================================================
// PERMISSION
// ============================================================

model Permission {
  id String @id @default(uuid()) @db.Uuid

  key String @unique @db.VarChar(100)

  module String @db.VarChar(50)
  action String @db.VarChar(50)

  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

// ============================================================
// ROLE PERMISSION
// ============================================================

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// USER
// ============================================================

model User {
  id String @id @default(uuid()) @db.Uuid

  companyId String? @map("company_id") @db.Uuid
  roleId    String  @map("role_id") @db.Uuid

  firstName String @map("first_name") @db.VarChar(100)
  lastName  String @map("last_name") @db.VarChar(100)

  email String  @unique @db.VarChar(255)
  phone String? @db.VarChar(50)

  passwordHash String @map("password_hash") @db.VarChar(255)

  mustChangePassword Boolean @default(false) @map("must_change_password")

  status UserStatus @default(ACTIVE)

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id])

  refreshTokens RefreshToken[]

  auditLogs AuditLog[]

  @@index([companyId])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

// ============================================================
// REFRESH TOKEN
// ============================================================

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  tokenHash String @unique @map("token_hash") @db.VarChar(255)
  jti       String @unique @db.VarChar(100)

  userAgent String? @map("user_agent") @db.VarChar(500)
  ipAddress String? @map("ip_address") @db.VarChar(50)

  isRevoked Boolean   @default(false) @map("is_revoked")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  replacedById String? @map("replaced_by_id") @db.Uuid

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@map("refresh_tokens")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  companyId String? @map("company_id") @db.Uuid
  userId    String? @map("user_id") @db.Uuid

  action String @db.VarChar(100)
  entity String @db.VarChar(100)

  entityId String? @map("entity_id") @db.VarChar(100)

  metadata Json?

  ipAddress String? @map("ip_address") @db.VarChar(50)
  userAgent String? @map("user_agent") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id])

  user User? @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// CLIENT
// ============================================================

model Client {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid

  name String @db.VarChar(255)

  clientCode String @unique @map("client_code") @db.VarChar(50)

  industry String? @db.VarChar(150)

  contactName  String? @map("contact_name") @db.VarChar(150)
  contactEmail String? @map("contact_email") @db.VarChar(255)
  contactPhone String? @map("contact_phone") @db.VarChar(50)

  website String? @db.VarChar(255)

  gstNumber String? @map("gst_number") @db.VarChar(30)
  panNumber String? @map("pan_number") @db.VarChar(20)

  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")

  city       String?
  state      String?
  country    String?
  postalCode String? @map("postal_code")

  logoUrl String? @map("logo_url") @db.VarChar(500)

  status ClientStatus @default(ACTIVE)

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by_id") @db.Uuid
  updatedById String? @map("updated_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  candidates Candidate[]
  bgvCases   BGVCase[]
  reports    BGVReport[]

  @@index([companyId])
  @@index([status])
  @@index([companyId, isDeleted])
  @@map("clients")
}

// ============================================================
// CANDIDATE
// ============================================================

model Candidate {
  id String @id @default(uuid()) @db.Uuid

  companyId String @map("company_id") @db.Uuid
  clientId  String @map("client_id") @db.Uuid

  candidateCode String @map("candidate_code") @db.VarChar(50)

  firstName String @map("first_name") @db.VarChar(100)
  lastName  String @map("last_name") @db.VarChar(100)

  email String  @db.VarChar(255)
  phone String? @db.VarChar(50)

  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  gender String? @db.VarChar(30)

  currentAddress   String? @map("current_address")
  permanentAddress String? @map("permanent_address")

  status CandidateStatus @default(PENDING)

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  createdById String? @map("created_by_id") @db.Uuid
  updatedById String? @map("updated_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  client Client @relation(fields: [clientId], references: [id])

  bgvCases BGVCase[]

  documents CandidateDocument[]

  consents CandidateConsent[]

  reports BGVReport[]

  @@unique([companyId, candidateCode])
  @@index([companyId, status])
  @@index([companyId, clientId])
  @@index([email])
  @@map("candidates")
}

// ============================================================
// BGV CASE
// ============================================================

model BGVCase {
  id String @id @default(uuid()) @db.Uuid

  companyId   String @map("company_id") @db.Uuid
  clientId    String @map("client_id") @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid

  caseNumber String @unique @map("case_number") @db.VarChar(50)

  clientReference String? @map("client_reference") @db.VarChar(100)

  packageName String? @map("package_name") @db.VarChar(150)

  status BGVCaseStatus @default(DRAFT)

  overallResult BGVOverallResult @default(PENDING)

  initiatedAt DateTime? @map("initiated_at")
  completedAt DateTime? @map("completed_at")

  assignedToId String? @map("assigned_to_id") @db.Uuid

  remarks String?

  createdById String? @map("created_by_id") @db.Uuid
  updatedById String? @map("updated_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  client Client @relation(fields: [clientId], references: [id])

  candidate Candidate @relation(fields: [candidateId], references: [id])

  checks VerificationCheck[]

  report BGVReport?

  consents CandidateConsent[]

  events VerificationEvent[]

  @@index([companyId, status])
  @@index([companyId, clientId])
  @@index([candidateId])
  @@index([overallResult])
  @@map("bgv_cases")
}

// ============================================================
// VERIFICATION CHECK
// ============================================================

model VerificationCheck {
  id String @id @default(uuid()) @db.Uuid

  caseId String @map("case_id") @db.Uuid

  type VerificationType

  provider VerificationProvider

  status VerificationStatus @default(PENDING)

  result VerificationResult @default(PENDING)

  priority Int @default(0)

  providerRequestId String? @map("provider_request_id") @db.VarChar(150)

  providerReferenceId String? @map("provider_reference_id") @db.VarChar(150)

  inputData Json? @map("input_data") @db.JsonB

  resultData Json? @map("result_data") @db.JsonB

  rawResponse Json? @map("raw_response") @db.JsonB

  failureReason String? @map("failure_reason")

  remarks String?

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  retryCount Int @default(0) @map("retry_count")

  isLocked   Boolean   @default(false) @map("is_locked")
  lockedAt   DateTime? @map("locked_at")
  lockedById String?   @map("locked_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  case BGVCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  events    VerificationEvent[]
  documents CandidateDocument[]

  @@index([caseId])
  @@index([type])
  @@index([status])
  @@index([provider])
  @@index([providerReferenceId])
  @@map("verification_checks")
}

// ============================================================
// VERIFICATION EVENT
// ============================================================

model VerificationEvent {
  id String @id @default(uuid()) @db.Uuid

  caseId String @map("case_id") @db.Uuid

  verificationId String? @map("verification_id") @db.Uuid

  eventType VerificationEventType

  status VerificationStatus?

  message String?

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  case BGVCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  verification VerificationCheck? @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([verificationId])
  @@index([eventType])
  @@index([createdAt])
  @@map("verification_events")
}

// ============================================================
// CANDIDATE DOCUMENT
// ============================================================

model CandidateDocument {
  id String @id @default(uuid()) @db.Uuid

  candidateId    String  @map("candidate_id") @db.Uuid
  verificationId String? @map("verification_id") @db.Uuid

  documentType DocumentType

  fileName String @map("file_name") @db.VarChar(255)

  fileUrl String @map("file_url") @db.VarChar(1000)

  mimeType String? @map("mime_type") @db.VarChar(100)

  fileSize Int? @map("file_size")

  documentNumber String? @map("document_number") @db.VarChar(100)

  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  verifiedAt DateTime? @map("verified_at")

  remarks String?

  candidate    Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  verification VerificationCheck? @relation(fields: [verificationId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([verificationId])
  @@index([documentType])
  @@index([verificationStatus])
  @@map("candidate_documents")
}

// ============================================================
// CANDIDATE CONSENT
// ============================================================

model CandidateConsent {
  id String @id @default(uuid()) @db.Uuid

  candidateId String @map("candidate_id") @db.Uuid
  caseId      String @map("case_id") @db.Uuid

  consentType ConsentType

  consentGiven Boolean @default(false) @map("consent_given")

  consentVersion String? @map("consent_version") @db.VarChar(50)

  consentText String? @map("consent_text")

  ipAddress String? @map("ip_address") @db.VarChar(50)

  userAgent String? @map("user_agent") @db.VarChar(500)

  consentedAt DateTime? @map("consented_at")

  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  case BGVCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([caseId])
  @@index([consentType])
  @@map("candidate_consents")
}

// ============================================================
// BGV REPORT
// ============================================================

model BGVReport {
  id String @id @default(uuid()) @db.Uuid

  companyId   String @map("company_id") @db.Uuid
  clientId    String @map("client_id") @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid
  caseId      String @unique @map("case_id") @db.Uuid

  reportNumber String @unique @map("report_number") @db.VarChar(100)

  status ReportStatus @default(DRAFT)

  overallResult BGVOverallResult

  summary String?

  reportData Json @map("report_data") @db.JsonB

  pdfUrl String? @map("pdf_url") @db.VarChar(1000)

  generatedAt DateTime? @map("generated_at")

  reviewedAt DateTime? @map("reviewed_at")

  reviewedById String? @map("reviewed_by_id") @db.Uuid

  sentToClientAt DateTime? @map("sent_to_client_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  client Client @relation(fields: [clientId], references: [id])

  candidate Candidate @relation(fields: [candidateId], references: [id])

  case BGVCase @relation(fields: [caseId], references: [id])

  @@index([companyId])
  @@index([clientId])
  @@index([candidateId])
  @@index([status])
  @@index([overallResult])
  @@map("bgv_reports")
}

// ============================================================
// ENUMS
// ============================================================

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum CandidateStatus {
  PENDING
  INVITED
  IN_PROGRESS
  VERIFICATION_IN_PROGRESS
  COMPLETED
  WITHDRAWN
  ON_HOLD
}

enum BGVCaseStatus {
  DRAFT
  INITIATED
  CONSENT_PENDING
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum BGVOverallResult {
  PENDING
  CLEAR
  MINOR_DISCREPANCY
  MAJOR_DISCREPANCY
  UNABLE_TO_VERIFY
  REQUIRES_REVIEW
}

enum VerificationType {
  PAN
  UAN
  COURT
  IDENTITY
  ADDRESS
  EDUCATION
  EMPLOYMENT
  DOCUMENT
  DOCUMENT_FORGERY
  CIBIL
  TWENTY_SIX_AS
  POLICE
}

enum VerificationProvider {
  SUREPASS
  MANUAL
  INTERNAL
}

enum VerificationStatus {
  PENDING
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
}

enum VerificationResult {
  PENDING
  VERIFIED
  NOT_VERIFIED
  MATCH
  MISMATCH
  NO_RECORD_FOUND
  RECORD_FOUND
  REQUIRES_REVIEW
  UNABLE_TO_VERIFY
}

enum VerificationEventType {
  CREATED
  QUEUED
  STARTED
  API_REQUEST
  API_RESPONSE
  WEBHOOK_RECEIVED
  RETRY
  COMPLETED
  FAILED
  MANUAL_REVIEW
  STATUS_CHANGED
}

enum DocumentType {
  PAN
  AADHAAR
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  EDUCATION_CERTIFICATE
  EXPERIENCE_LETTER
  SALARY_SLIP
  ADDRESS_PROOF
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  REQUIRES_REVIEW
}

enum ConsentType {
  BGV_CONSENT
  IDENTITY_VERIFICATION
  EMPLOYMENT_VERIFICATION
  COURT_VERIFICATION
  DOCUMENT_VERIFICATION
}

enum ReportStatus {
  DRAFT
  GENERATED
  REVIEW_PENDING
  APPROVED
  SENT_TO_CLIENT
  ARCHIVED
}
